{
	admin off
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

eduslides.encode.uz {
	import security_headers
	encode zstd gzip
	reverse_proxy web:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

www.eduslides.encode.uz {
	redir https://eduslides.encode.uz{uri} permanent
}

admin-eduslides.encode.uz {
	import security_headers
	encode zstd gzip
	reverse_proxy admin:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

www.admin-eduslides.encode.uz {
	redir https://admin-eduslides.encode.uz{uri} permanent
}

api-eduslides.encode.uz {
	import security_headers
	encode zstd gzip
	reverse_proxy api:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

www.api-eduslides.encode.uz {
	redir https://api-eduslides.encode.uz{uri} permanent
}
