# Copy to .env. Never commit real secrets.
POSTGRES_DB=slideforge
POSTGRES_USER=slideforge
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/slideforge
DATABASE_USER=slideforge
DATABASE_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_HASH_BASE64=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_SECURE=false
RENDERER_URL=http://renderer:8090
EXPORT_WORKER_ENABLED=true
EXPORT_POLL_INTERVAL_MS=1000
EXPORT_STALE_RUNNING_MINUTES=5
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
AI_PROVIDER_API_KEY=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=slideforge
S3_ACCESS_KEY=slideforge
S3_SECRET_KEY=local-development-secret
RABBITMQ_URL=amqp://guest:guest@localhost:5672
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=change-me
